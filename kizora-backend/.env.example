# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
# PORT is injected automatically by Render — do NOT set it here for production

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set to your deployed frontend URL (e.g. https://kizora.vercel.app)
# Leave empty during local development (localhost:5173 is always allowed)
FRONTEND_URL=

# ─── AniList OAuth ────────────────────────────────────────────────────────────
# Register at: https://anilist.co/settings/developer
# Redirect URI: https://<your-render-service>.onrender.com/auth/callback
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# ─── Stream Provider Base URLs ────────────────────────────────────────────────
# All providers have working defaults — only set these to override.

# Provider 1 — AniWixi (Priority 1, primary streaming source)
ANIWIXI_API_URL=

# Provider 2 — Fetch-Stream (Priority 2, ToonStream + AnimeSalt)
FETCH_STREAM_API_URL=

# Provider 3 — AnimeWorldIndia (Priority 3, local or remote daemon)
# Leave empty on Render unless you run a remote AWI daemon
ANIME_WORLD_INDIA_API_URL=

# Provider 4 — Nekosia (Priority 4, image/asset API — streaming pass-through)
NEKOSIA_API_URL=

# Provider 5 — AnimeStreamingBoost (Priority 5, currently quarantined)
# No URL needed — adapter is safely disabled
